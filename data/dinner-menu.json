      "in": ["potato", "pepper", "garlic", "vinegar"],
      "out": ["tomato", "egg", "tofu", "cilantro"],
      "coupon": "potato"
    },
    {
      "id": "garlic_eggplant",
      "name_zh": "蒜蓉茄子",
