      "in": ["cucumber", "garlic", "vinegar", "scallion"],
      "out": ["tomato", "egg", "tofu", "potato"],
      "coupon": "cucumber"
    },
    {
      "id": "pepper_potato",
      "name_zh": "青椒土豆丝",
