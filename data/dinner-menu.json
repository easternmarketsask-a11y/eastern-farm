      "in": ["eggplant", "garlic", "scallion", "sesame_oil"],
      "out": ["cucumber", "tomato", "tofu", "potato"],
      "coupon": "eggplant"
    },
    {
      "id": "cilantro_tofu",
      "name_zh": "香菜拌豆腐",
