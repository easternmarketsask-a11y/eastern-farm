// ============================================================
// World Cup Lottery — Firestore Security Rules (2026, removable)
// 项目:eastern-market-members
// 把下面这一段合并进现有 firestore.rules 的
//   match /databases/{database}/documents { ... } 块内部。
// 七月底删除观赛台时,把这一段整段删掉即可。
// ============================================================

// ---- 配置:人人只读,写仅限云函数(admin SDK 绕过规则)----
match /wc_lottery_config/{doc} {
  allow read: if true;
  allow write: if false;
}

// ---- 每场抽奖:文档只读(状态/deadline),报名子集合受控写 ----
match /wc_lottery/{matchId} {
  allow read: if true;
  allow write: if false;            // seed / 开奖只走云函数

  match /entries/{uid} {
    // 只能读自己的报名
    allow read: if request.auth != null && request.auth.uid == uid;

    // 报名即抽改版后,entries 一律由云函数 wcLotteryEnter(admin SDK)写入,
    // 客户端不再直写 → 全部关闭(防伪造 entry)。云函数绕过规则不受影响。
    allow write: if false;
  }
}

// ---- 中奖名单:只能读自己的,写仅限云函数 ----
match /wc_lottery_winners/{matchId}/w/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow write: if false;
}

// ---- 每日抽奖次数计数器:只能读自己的,写仅限云函数(事务内原子计数)----
match /wc_lottery_daily/{doc} {
  allow read: if request.auth != null && doc.matches(request.auth.uid + '_.*');
  allow write: if false;
}

// ---- 券码索引:全不可读写(只有云函数 admin 访问;核销走 wcLotteryRedeem 函数)----
match /wc_coupons/{code} {
  allow read, write: if false;
}

// ---- 后台口令(收银核销口令):全不可读写,只有云函数能读 ----
match /wc_lottery_admin/{doc} {
  allow read, write: if false;
}

// ---- 注意:农场币不存 farm_players,存 members/{uid}.gameSave 存档(隐私) ----
// 云函数只把中奖币写进可信的 win 文档(wc_lottery_winners/.../w/{uid}),
// 前端读 win.coins 按 localStorage 幂等增量加到本地存档(见 lottoApplyWin)。
// 后台绝不写 farm_players.coins —— game-sync 故意把 coins 从公开镜像删掉,写了也读不到。
// 现有 members / farm_players 规则无需改动。
